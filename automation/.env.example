# ==== Supabase (самохостед или облачный) ====
# URL проекта, например https://supabase.example.ru
SUPABASE_URL=
# service_role ключ (воркер обходит RLS!). Держите файл в секрете.
SUPABASE_SERVICE_KEY=

# ==== Поведение воркера ====
# Пауза между опросами очереди, секунд
POLL_INTERVAL_SEC=20
# 1 — невидимый браузер, 0 — показывать окно (для первого запуска/отладки)
HEADLESS=1
# Адрес по умолчанию, если у заявки/очереди не заполнен address
DEFAULT_ADDRESS=
# 1 — автоматически ставить в очередь все новые заявки (status=new).
# 0 — только те, что добавлены кнопкой «Отправить на Профи» в приложении.
AUTO_ENQUEUE_NEW_REQUESTS=0
# 1 — не нажимать финальную кнопку отправки (прогон для проверки)
DRY_RUN=0
# Каталог профиля браузера с сохранённым логином Профи.ру
PROFILE_DIR=./state/profi-profile
