# Шаблон окружения: node deploy/generate-keys.mjs → вставить вывод сюда,
# затем дописать секреты провайдеров. Реальный .env НЕ коммитится.
# Файл кладётся в /opt/arendora/stack/.env на сервере.

# --- из generate-keys.mjs ---
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
JWT_EXPIRY=3600
PUSH_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=

# --- адреса ---
# SITE_URL / API_EXTERNAL_URL видят GoTrue и edge-функции (ссылки в письмах,
# redirect после логина). Имена хостов для Caddy — в stack/Caddyfile.
# Пока домен не оплачен — см. deploy/README.md, раздел «Домен».
SITE_URL=https://arendora.ru
API_EXTERNAL_URL=https://api.arendora.ru

# --- соцвход (Yandex ID / VK ID / Mail.ru) ---
# Redirect URI в кабинках провайдеров: https://api.arendora.ru/functions/v1/oauth/callback
OAUTH_STATE_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=

# --- письма: собственный SMTP-хостинг домена arendora.ru ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Arendora <noreply@arendora.ru>

# --- web-push (VAPID, генерирует generate-keys.mjs) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
